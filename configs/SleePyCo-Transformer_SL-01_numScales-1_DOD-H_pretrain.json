{
    "dataset": {
        "name": "DOD-H",
        "eeg_channel": "C3-RPA",
        "num_splits": 5,
        "seq_len": 1,
        "target_idx": 0,
        "root_dir": "./"
    },

    "backbone": {
        "name": "SleePyCo",
        "init_weights": false,
        "dropout": false
    },

    "proj_head": {
        "name": "MLP",
        "dim": 128
    },

    "training_params": {
        "mode": "pretrain",
        "max_epochs": 500,
        "batch_size": 256,
        "lr": 0.0005,
        "weight_decay": 0.0001,
        "temperature": 0.07,
        "val_period": 50,
        "early_stopping": {
            "mode": "min",
            "patience": 20
        }
    }
}