{
    "dataset": {
        "name": "ANPHY",
        "eeg_channel": "C3-TP10",
        "num_splits": 5,
        "seq_len": 10,
        "target_idx": -1,
        "root_dir": "./"
    },

    "backbone": {
        "name": "SleePyCo",
        "init_weights": false,
        "dropout": false
    },

    "feature_pyramid": {
        "dim": 128,
        "num_scales": 3
    },

    "classifier": {
        "name": "Transformer",
        "model_dim": 128,
        "feedforward_dim": 128,
        "pool": "attn",
        "dropout": false,
        "num_classes": 5,
        "pos_enc": {
            "dropout": false
        }
    },

    "training_params": {
        "mode": "scratch",
        "max_epochs": 500,
        "batch_size": 8,
        "lr": 0.0005,
        "weight_decay": 0.0001,
        "val_period": 500,
        "early_stopping": {
            "mode": "min",
            "patience": 20
        }
    },

    "hpo": {
        "n_trials": 30,
        "fold": 1,
        "max_epochs": 100,
        "val_period": 100,
        "seed": 42,
        "search": {
            "lr": [0.0001, 0.003],
            "weight_decay": [0.000001, 0.01],
            "batch_size": [4, 8, 16, 32],
            "feature_dim": [128, 256],
            "model_dim": [128, 256],
            "feedforward_dim": [256, 512],
            "pool": ["mean", "attn"]
        }
    }
}